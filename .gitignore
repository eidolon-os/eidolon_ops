.pytest_cache/
.ruff_cache/
.venv/
.coverage
coverage.xml
dist/
build/
*.egg-info/
__pycache__/
*.pyc
.eidolon-ops/
diagnostics/
config/eidolon-pi.toml
config/hosts/*.toml
# One operator's record of their own runs, beside the profile it belongs to.
# Ignored for the same reason the profiles are, plus one this repository learned
# the hard way: an untracked file is a dirty worktree, and a dirty worktree is
# something `require_clean` refuses to seal a release from.
config/hosts/runs/
!config/hosts/*.example.toml

# The console's interface is a build artifact; `cd web && npm run build` makes it.
src/eidolon_ops/console/static/
web/node_modules/

# Finder writes these anywhere a directory is opened, and an untracked file is
# a dirty worktree: `require_clean` would refuse to seal a release because
# somebody looked in a folder.
.DS_Store
